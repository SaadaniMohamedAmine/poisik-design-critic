generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Analysis {
  id        String   @id @default(cuid())
  sessionId String
  imageUrl  String
  result    Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
}
